# HHCS site on Hostinger (Apache). Upload this file with the rest of the site into public_html.
Options -Indexes
DirectorySlash Off
RewriteEngine On
RewriteBase /

# Always use https and the bare domain
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://hhcstax.com%{REQUEST_URI} [L,R=301]

# Admin, signing and old portal links live on the Horizons app now
RewriteRule ^(admin|admin-login|admin/.*|sign)$ https://app.hhcstax.com/$1 [R=302,L,QSA]

# /page and /page/ serve /page/index.html
RewriteRule ^(.+)/$ /$1 [L,R=301]
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ $1/index.html [L]

# Real files are served as they are
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Everything else goes to the app, which shows its own not-found page
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|svg|png|jpg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
